# Optional. Without it the app uses NOAA's Aviation Weather Center, which needs no key.
# Free token: https://avwx.rest
AVWX_TOKEN=

# Any long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Where accounts are stored. Defaults to instance/users.json
# USERS_FILE=/var/data/users.json
